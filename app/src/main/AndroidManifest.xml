<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Keep the CPU + Wi-Fi radio alive while a download is transferring
         (device asleep); released as soon as no download is active. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the user exclude GameNative from battery optimization so Doze
         does not suspend the network during multi-hour downloads. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".PluviaApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="${icon}"
        android:isGame="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Pluvia"
        android:allowAudioPlaybackCapture="true"
        android:appCategory="game"
        tools:targetApi="29">
        <!--
         android:windowSoftInputMode must always be in the activity block.
         IME padding with composables like 'Scaffold' will have terrible resizing consequences, if in the activity tag.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="${screenOrientation}"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.Pluvia">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="pluvia"
                    android:scheme="home" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Nexus issues signed nxm:// links after a free user authorizes a file on the website. -->
                <data android:scheme="nxm" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Relay redirects here after the user links their Discord account. -->
                <data
                    android:host="discord-linked"
                    android:scheme="gamenative" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.gamenative.LAUNCH_GAME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gamenative" android:host="run" />
            </intent-filter>

            <!--Allows app window to be resized on Oculus Quest VR headsets-->
            <meta-data
                android:name="com.oculus.vrshell.supports_free_resizing"
                android:value="true" />

        </activity>

        <!-- Nexus OAuth uses an external browser and returns only through this exact native redirect. -->
        <activity
            android:name=".ui.screen.auth.NexusOAuthCallbackActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Pluvia.OAuthCallback">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:path="/callback"
                    android:scheme="app.gamenative" />
            </intent-filter>
        </activity>

        <!-- GOG OAuth (in-app WebView; intercepts redirect for automatic code capture) -->
        <activity
            android:name=".ui.screen.auth.GOGOAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Pluvia" />

        <!-- Epic OAuth (in-app WebView; intercepts redirect for automatic code capture) -->
        <activity
            android:name=".ui.screen.auth.EpicOAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Pluvia" />

        <!-- Amazon OAuth (in-app WebView; PKCE flow for Amazon Games auth) -->
        <activity
            android:name=".ui.screen.auth.AmazonOAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Pluvia" />

        <!-- Launcher icon aliases to allow switching app icon at runtime -->
        <activity-alias
            android:name=".MainActivityAliasDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityAliasAlt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".service.SteamService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.gog.GOGService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.epic.EpicService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.amazon.AmazonService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Process anchor while any download is transferring; started/stopped
             by GameDownloadService. Lets downloads survive sleep independent
             of any store service's lifecycle. -->
        <service
            android:name=".service.download.DownloadForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.NexusModImportService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Handles the Exit action on foreground-service notifications.
            See app.gamenative.service.NotificationActionReceiver for the rationale —
            routing through a broadcast avoids the FGS contract that would otherwise
            crash the app when Exit is tapped on a notification whose owning service
            isn't currently running.
        -->
        <receiver
            android:name=".service.NotificationActionReceiver"
            android:exported="false" />

        <!-- FileProvider for secure file sharing (for APK installation) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
